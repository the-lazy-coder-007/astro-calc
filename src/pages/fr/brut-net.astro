---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
const title = `Brut → Net | ${SITE_TITLE}`;
const description = 'Simulez votre salaire net avant impôt et le net après impôt pour un salaire brut annuel.';
const defaultBrut = 50000;
const contributionRate = 0.235;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-hero">
				<p class="eyebrow">Travail & Salaire</p>
				<h1>Brut → Net</h1>
				<p>Estimez votre salaire net avant impôt et le revenu d’une fiche de paie française.</p>
			</section>

			<section class="hero-card">
				<div class="calculator-input-group">
					<form id="salary-form">
						<label for="brut">Salaire brut annuel</label>
						<div style="position: relative;">
							<input id="brut" name="brut" type="number" min="0" step="1000" value={defaultBrut} required />
							<span style="position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 1.5rem; color: rgba(96, 115, 159, 0.4);">€</span>
						</div>
						<input type="range" id="brut-slider" min="0" max="500000" step="1000" value={defaultBrut} />
						<div class="input-hint">Ajustez votre salaire brut</div>
						
						<label for="rate" style="margin-top: 1.5rem;">Taux de charges salariales</label>
						<div style="position: relative;">
							<input id="rate" name="rate" type="number" min="0" max="100" step="0.1" value={contributionRate * 100} />
							<span style="position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 1.5rem; color: rgba(96, 115, 159, 0.4);">%</span>
						</div>
						<input type="range" id="rate-slider" min="0" max="50" step="0.1" value={contributionRate * 100} />
						<div class="input-hint">Entre 20 et 25% typiquement en France</div>
						
						<button type="submit" style="margin-top: 1rem;">Calculer le net</button>
					</form>
				</div>
				<div id="results" class="results calculator-result" aria-live="polite"></div>
			</section>
		</main>
		<Footer />
		<script type="module">
			const form = document.getElementById('salary-form');
			const results = document.getElementById('results');

			function formatEUR(value) {
				return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(value);
			}

			function render(brut, rate) {
				const contributions = brut * rate;
				const netAvantImpot = brut - contributions;
				const { totalTax } = (function(income) {
					let remaining = Math.max(0, income);
					let previous = 0;
					let total = 0;
					const brackets = [
						{ threshold: 10777, rate: 0 },
						{ threshold: 27478, rate: 0.11 },
						{ threshold: 78570, rate: 0.30 },
						{ threshold: 168994, rate: 0.41 },
						{ threshold: Infinity, rate: 0.45 },
					];
					for (const bracket of brackets) {
						if (remaining <= 0) break;
						const slice = Math.min(remaining, bracket.threshold - previous);
						total += slice * bracket.rate;
						remaining -= slice;
						previous = bracket.threshold;
					}
					return { totalTax: total };
				})(netAvantImpot);
				const netApresImpot = netAvantImpot - totalTax;
				const effectiveRate = brut > 0 ? (totalTax / brut) * 100 : 0;

				return `
					<div class="summary">
						<p><strong>Salaire brut :</strong> ${formatEUR(brut)}</p>
						<p><strong>Charges salariales :</strong> ${formatEUR(contributions)} (${(rate * 100).toFixed(1)} %)</p>
						<p><strong>Salaire net avant impôt :</strong> ${formatEUR(netAvantImpot)}</p>
						<p><strong>Impôt estimé :</strong> ${formatEUR(totalTax)}</p>
						<p><strong>Salaire net après impôt :</strong> ${formatEUR(netApresImpot)}</p>
						<p><strong>Taux fiscal effectif :</strong> ${effectiveRate.toFixed(1)} %</p>
					</div>
				`;
			}

			function update() {
				const brut = Number(document.getElementById('brut').value || 0);
				const rate = Number(document.getElementById('rate').value || 0) / 100;
				results.innerHTML = render(brut, rate);
			}

			const brutInput = document.getElementById('brut');
			const rateInput = document.getElementById('rate');
			const brutSlider = document.getElementById('brut-slider');
			const rateSlider = document.getElementById('rate-slider');

			// Sync brut input and slider
			brutInput.addEventListener('input', (e) => {
				brutSlider.value = e.target.value;
				update();
			});
			brutSlider.addEventListener('input', (e) => {
				brutInput.value = e.target.value;
				update();
			});

			// Sync rate input and slider
			rateInput.addEventListener('input', (e) => {
				rateSlider.value = e.target.value;
				update();
			});
			rateSlider.addEventListener('input', (e) => {
				rateInput.value = e.target.value;
				update();
			});

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				update();
			});

			update();
		</script>
	</body>
</html>
