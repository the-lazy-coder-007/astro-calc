---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const title = `Calcul remise | ${SITE_TITLE}`;
const description = 'Calculez le prix après remise et le montant économisé sur votre achat.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-hero">
				<p class="eyebrow">Quotidien & lifestyle</p>
				<h1>Calcul remise</h1>
				<p>Calculez la nouvelle étiquette et l’économie réalisée grâce à la remise.</p>
			</section>

			<section class="hero-card">
				<div class="calculator-input-group">
					<form id="discount-form">
						<label for="price">Prix initial</label>
						<div style="position: relative;">
							<input id="price" name="price" type="number" min="0" step="0.01" value="120" required />
							<span style="position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 1.5rem; color: rgba(96, 115, 159, 0.4);">€</span>
						</div>
						<input type="range" id="price-slider" min="0" max="5000" step="1" value="120" />
						<div class="input-hint">Prix avant remise</div>
						
						<label for="discount" style="margin-top: 1.5rem;">Pourcentage de remise</label>
						<div style="position: relative;">
							<input id="discount" name="discount" type="number" min="0" max="100" step="0.1" value="20" required />
							<span style="position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 1.5rem; color: rgba(96, 115, 159, 0.4);">%</span>
						</div>
						<input type="range" id="discount-slider" min="0" max="100" step="0.1" value="20" />
						<div class="input-hint">De 0 à 100%</div>
						
						<button type="submit" style="margin-top: 1rem;">Calculer remise</button>
					</form>
				</div>
				<div id="results" class="results calculator-result" aria-live="polite"></div>
			</section>
		</main>
		<Footer />
		<script type="module">
			const form = document.getElementById('discount-form');
			const results = document.getElementById('results');

			function formatEUR(value) {
				return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 }).format(value);
			}

			function update() {
				const price = Number(document.getElementById('price').value || 0);
				const discount = Number(document.getElementById('discount').value || 0) / 100;
				const reduction = price * discount;
				const finalPrice = price - reduction;

				results.innerHTML = `
					<p><strong>Montant de la remise :</strong> ${formatEUR(reduction)}</p>
					<p><strong>Prix après remise :</strong> ${formatEUR(finalPrice)}</p>
					<p><strong>Vous économisez :</strong> ${(discount * 100).toFixed(1)} %</p>
				`;
			}

			const priceInput = document.getElementById('price');
			const discountInput = document.getElementById('discount');
			const priceSlider = document.getElementById('price-slider');
			const discountSlider = document.getElementById('discount-slider');

			priceInput.addEventListener('input', (e) => { priceSlider.value = e.target.value; update(); });
			priceSlider.addEventListener('input', (e) => { priceInput.value = e.target.value; update(); });

			discountInput.addEventListener('input', (e) => { discountSlider.value = e.target.value; update(); });
			discountSlider.addEventListener('input', (e) => { discountInput.value = e.target.value; update(); });

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				update();
			});

			update();
		</script>
	</body>
</html>
