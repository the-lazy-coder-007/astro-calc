---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_TITLE } from '../../consts';

const title = `Épargne | ${SITE_TITLE}`;
const description = 'Projetez le montant futur de votre épargne avec intérêts composés et versements réguliers.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<Breadcrumb items={[
				{ label: 'Accueil', href: '/' },
				{ label: 'Calculatrices', href: '/fr' },
				{ label: 'Finances & crédit', href: '/fr/finances' },
				{ label: 'Épargne & intérêt composé' }
			]} />
			<section class="page-hero">
				<p class="eyebrow">Finances & crédit</p>
				<h1>Épargne & intérêt composé</h1>
				<p>Calculez la croissance de votre épargne avec un taux annuel et des versements réguliers.</p>
			</section>

			<section class="hero-card">
				<div class="calculator-input-group">
					<form id="savings-form">
						<label for="initial">Épargne initiale</label>
						<div class="input-with-unit">
							<input id="initial" name="initial" type="number" min="0" step="100" value="5000" required />
							<span class="input-unit">€</span>
						</div>
						<input type="range" id="initial-slider" min="0" max="500000" step="1000" value="5000" />
						<div class="input-hint">Capital initial</div>
						
						<label for="contribution" style="margin-top: 1.5rem;">Versement mensuel</label>
						<div class="input-with-unit">
							<input id="contribution" name="contribution" type="number" min="0" step="10" value="200" required />
							<span class="input-unit">€</span>
						</div>
						<input type="range" id="contribution-slider" min="0" max="5000" step="10" value="200" />
						<div class="input-hint">Contribution régulière</div>
						
						<label for="rate" style="margin-top: 1.5rem;">Taux annuel</label>
						<div class="input-with-unit">
							<input id="rate" name="rate" type="number" min="0" step="0.01" value="4" required />
							<span class="input-unit">%</span>
						</div>
						<input type="range" id="rate-slider" min="0" max="10" step="0.01" value="4" />
						<div class="input-hint">Rendement annuel</div>
						
						<label for="years" style="margin-top: 1.5rem;">Durée</label>
						<div class="input-with-unit">
							<input id="years" name="years" type="number" min="1" step="1" value="10" required />
							<span class="input-unit">ans</span>
						</div>
						<input type="range" id="years-slider" min="1" max="50" step="1" value="10" />
						<div class="input-hint">Période d'investissement</div>
						
						<button type="submit" style="margin-top: 1rem;">Calculer l'épargne</button>
					</form>
				</div>
				<div id="results" class="results calculator-result" aria-live="polite"></div>
			</section>
		</main>
		<Footer />
		<script type="module">
			const form = document.getElementById('savings-form');
			const results = document.getElementById('results');

			function formatEUR(value) {
				return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(value);
			}

			function update() {
				const principal = Number(document.getElementById('initial').value || 0);
				const contribution = Number(document.getElementById('contribution').value || 0);
				const rate = Number(document.getElementById('rate').value || 0) / 100;
				const years = Number(document.getElementById('years').value || 0);
				const months = years * 12;
				let balance = principal;

				for (let i = 0; i < months; i++) {
					balance += contribution;
					balance *= 1 + rate / 12;
				}

				results.innerHTML = `
					<p><strong>Montant final :</strong> ${formatEUR(balance)}</p>
					<p><strong>Apport initial :</strong> ${formatEUR(principal)}</p>
					<p><strong>Total des versements :</strong> ${formatEUR(contribution * months)}</p>
				`;
			}

			const initialInput = document.getElementById('initial');
			const contributionInput = document.getElementById('contribution');
			const rateInput = document.getElementById('rate');
			const yearsInput = document.getElementById('years');

			const initialSlider = document.getElementById('initial-slider');
			const contributionSlider = document.getElementById('contribution-slider');
			const rateSlider = document.getElementById('rate-slider');
			const yearsSlider = document.getElementById('years-slider');

			initialInput.addEventListener('input', (e) => { initialSlider.value = e.target.value; update(); });
			initialSlider.addEventListener('input', (e) => { initialInput.value = e.target.value; update(); });

			contributionInput.addEventListener('input', (e) => { contributionSlider.value = e.target.value; update(); });
			contributionSlider.addEventListener('input', (e) => { contributionInput.value = e.target.value; update(); });

			rateInput.addEventListener('input', (e) => { rateSlider.value = e.target.value; update(); });
			rateSlider.addEventListener('input', (e) => { rateInput.value = e.target.value; update(); });

			yearsInput.addEventListener('input', (e) => { yearsSlider.value = e.target.value; update(); });
			yearsSlider.addEventListener('input', (e) => { yearsInput.value = e.target.value; update(); });

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				update();
			});

			update();
		</script>
	</body>
</html>
