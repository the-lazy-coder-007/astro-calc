---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | Home`} description="A French-first calculator platform built with Astro." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Astro Calc</h1>
			<p>Launch your first calculator platform with a France-first income tax tool.</p>
			<section class="home-features">
				<a class="feature-card" href="/fr/salaire-net">
					<h2>Calculateur de Salaire Net</h2>
					<p>Estimez l'impôt sur le revenu français avec les tranches 2025/2026.</p>
				</a>
				<a class="feature-card" href="/fr">
					<h2>Voir toutes les calculatrices</h2>
					<p>Accédez à toutes les pages de calcul et découvrez la structure de votre plateforme.</p>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
