---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_TITLE } from '../../consts';

const title = `Coût carburant | ${SITE_TITLE}`;
const description = 'Calculez le coût en carburant pour un trajet en voiture en fonction de votre consommation et du prix du carburant.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<Breadcrumb items={[
				{ label: 'Accueil', href: '/' },
				{ label: 'Calculatrices', href: '/fr' },
				{ label: 'Auto & mobilité', href: '/fr/auto' },
				{ label: 'Coût carburant' }
			]} />
			<section class="page-hero">
				<p class="eyebrow">Auto & mobilité</p>
				<h1>Coût carburant</h1>
				<p>Estimez le budget carburant pour un trajet et le coût par personne.</p>
			</section>

			<section class="hero-card">
				<div class="calculator-input-group">
					<form id="fuel-form">
						<label for="distance">Distance du trajet</label>
						<div class="input-with-unit">
							<input id="distance" name="distance" type="number" min="0" step="5" value="120" required />
							<span class="input-unit">km</span>
						</div>
						<input type="range" id="distance-slider" min="0" max="5000" step="5" value="120" />
						<div class="input-hint">Distance en kilomètres</div>
						
						<label for="consumption" style="margin-top: 1.5rem;">Consommation moyenne</label>
						<div class="input-with-unit">
							<input id="consumption" name="consumption" type="number" min="0" step="0.1" value="6.5" required />
							<span class="input-unit">L/100km</span>
						</div>
						<input type="range" id="consumption-slider" min="3" max="15" step="0.1" value="6.5" />
						<div class="input-hint">Litres par 100 km</div>
						
						<label for="fuel-price" style="margin-top: 1.5rem;">Prix du carburant</label>
						<div class="input-with-unit">
							<input id="fuel-price" name="fuel-price" type="number" min="0" step="0.01" value="1.85" required />
							<span class="input-unit">€/L</span>
						</div>
						<input type="range" id="fuel-price-slider" min="0.5" max="3" step="0.01" value="1.85" />
						<div class="input-hint">Prix par litre</div>
						
						<label for="passengers" style="margin-top: 1.5rem;">Nombre de passagers</label>
						<div class="input-with-unit">
							<input id="passengers" name="passengers" type="number" min="1" step="1" value="2" required />
							<span class="input-unit">👤</span>
						</div>
						<input type="range" id="passengers-slider" min="1" max="10" step="1" value="2" />
						<div class="input-hint">De 1 à 10 passagers</div>
						
						<button type="submit" style="margin-top: 1rem;">Calculer le coût</button>
					</form>
				</div>
				<div id="results" class="results calculator-result" aria-live="polite"></div>
			</section>
		</main>
		<Footer />
		<script type="module">
			const form = document.getElementById('fuel-form');
			const results = document.getElementById('results');

			function formatEUR(value) {
				return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 }).format(value);
			}

			function update() {
				const distance = Number(document.getElementById('distance').value || 0);
				const consumption = Number(document.getElementById('consumption').value || 0);
				const price = Number(document.getElementById('fuel-price').value || 0);
				const passengers = Math.max(1, Number(document.getElementById('passengers').value || 1));
				const liters = (distance * consumption) / 100;
				const totalCost = liters * price;
				const perPassenger = totalCost / passengers;

				results.innerHTML = `
					<p><strong>Carburant total :</strong> ${liters.toFixed(1)} L</p>
					<p><strong>Coût total :</strong> ${formatEUR(totalCost)}</p>
					<p><strong>Coût par passager :</strong> ${formatEUR(perPassenger)}</p>
				`;
			}

			const distanceInput = document.getElementById('distance');
			const consumptionInput = document.getElementById('consumption');
			const priceInput = document.getElementById('fuel-price');
			const passengersInput = document.getElementById('passengers');

			const distanceSlider = document.getElementById('distance-slider');
			const consumptionSlider = document.getElementById('consumption-slider');
			const priceSlider = document.getElementById('fuel-price-slider');
			const passengersSlider = document.getElementById('passengers-slider');

			distanceInput.addEventListener('input', (e) => { distanceSlider.value = e.target.value; update(); });
			distanceSlider.addEventListener('input', (e) => { distanceInput.value = e.target.value; update(); });

			consumptionInput.addEventListener('input', (e) => { consumptionSlider.value = e.target.value; update(); });
			consumptionSlider.addEventListener('input', (e) => { consumptionInput.value = e.target.value; update(); });

			priceInput.addEventListener('input', (e) => { priceSlider.value = e.target.value; update(); });
			priceSlider.addEventListener('input', (e) => { priceInput.value = e.target.value; update(); });

			passengersInput.addEventListener('input', (e) => { passengersSlider.value = e.target.value; update(); });
			passengersSlider.addEventListener('input', (e) => { passengersInput.value = e.target.value; update(); });

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				update();
			});

			update();
		</script>
	</body>
</html>
