---
import { SITE_TITLE } from '../consts';
import { FR_CATEGORIES } from '../lib/fr/calculators.ts';

const today = new Date();
const githubUrl = 'https://github.com/the-lazy-coder-007/astro-calc';
const firstHalf = FR_CATEGORIES.slice(0, 4);
const secondHalf = FR_CATEGORIES.slice(4);
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-grid">
			<div>
				<h3>Catégories</h3>
				{firstHalf.map((category) => (
					<a href={`/fr/${category.slug}`}>{category.icon} {category.title}</a>
				))}
			</div>
			<div>
				<h3>Plus</h3>
				{secondHalf.map((category) => (
					<a href={`/fr/${category.slug}`}>{category.icon} {category.title}</a>
				))}
			</div>
			<div>
				<h3>À propos</h3>
				<a href="/fr/faq">FAQ</a>
				<a href="/fr/contact">Contact</a>
				<a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
			</div>
			<div>
				<h3>Légal</h3>
				<a href="/fr/mentions-legales">Mentions légales</a>
				<a href="/fr/contact">Signaler un bug</a>
			</div>
		</div>

		<div class="footer-bottom">
			<div class="footer-brand">
				<span aria-hidden="true">🇫🇷</span>
				<span>{SITE_TITLE}</span>
			</div>
			<div class="footer-links">
				<a href={githubUrl} target="_blank" rel="noopener noreferrer">Open Source sur GitHub</a>
				<a href="/fr/contact">Contribuer</a>
			</div>
		</div>
		<p style="margin: 1rem 0 0; font-size: 0.8rem; opacity: 0.75; text-align: center;">
			© {today.getFullYear()} {SITE_TITLE} · Calculs sans garantie · MIT License
		</p>
	</div>
</footer>
