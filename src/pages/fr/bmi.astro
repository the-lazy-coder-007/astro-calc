---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_TITLE } from '../../consts';

const title = `IMC | ${SITE_TITLE}`;
const description = 'Calculez votre indice de masse corporelle (IMC) et affichez votre catégorie santé.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<Breadcrumb items={[
				{ label: 'Accueil', href: '/' },
				{ label: 'Calculatrices', href: '/fr' },
				{ label: 'Santé', href: '/fr/sante' },
				{ label: 'Indice de masse corporelle' }
			]} />
			<section class="page-hero">
				<p class="eyebrow">Santé</p>
				<h1>Indice de masse corporelle</h1>
				<p>Calculez votre IMC et identifiez la classification santé correspondante.</p>
			</section>

			<section class="hero-card">
				<div class="calculator-input-group">
					<form id="bmi-form">
						<label for="weight">Poids</label>
						<div class="input-with-unit">
							<input id="weight" name="weight" type="number" min="0" step="0.1" value="70" required />
							<span class="input-unit">kg</span>
						</div>
						<input type="range" id="weight-slider" min="20" max="200" step="0.5" value="70" />
						<div class="input-hint">Entre 20 et 200 kg</div>
						
						<label for="height" style="margin-top: 1.5rem;">Taille</label>
						<div class="input-with-unit">
							<input id="height" name="height" type="number" min="0" step="0.5" value="175" required />
							<span class="input-unit">cm</span>
						</div>
						<input type="range" id="height-slider" min="100" max="250" step="0.5" value="175" />
						<div class="input-hint">Entre 100 et 250 cm</div>
						
						<button type="submit" style="margin-top: 1rem;">Calculer IMC</button>
					</form>
				</div>
				<div id="results" class="results calculator-result" aria-live="polite"></div>
			</section>
		</main>
		<Footer />
		<script type="module">
			const form = document.getElementById('bmi-form');
			const results = document.getElementById('results');

			function getCategory(bmi) {
				if (bmi < 18.5) return 'Insuffisance pondérale';
				if (bmi < 25) return 'Poids normal';
				if (bmi < 30) return 'Surpoids';
				return 'Obésité';
			}

			function update() {
				const weight = Number(document.getElementById('weight').value || 0);
				const height = Number(document.getElementById('height').value || 0) / 100;
				const bmi = height > 0 ? weight / (height * height) : 0;
				results.innerHTML = `
					<p><strong>IMC :</strong> ${bmi.toFixed(1)}</p>
					<p><strong>Classification :</strong> ${getCategory(bmi)}</p>
					<p>IMC normal : 18,5 – 24,9</p>
				`;
			}

			const weightInput = document.getElementById('weight');
			const heightInput = document.getElementById('height');
			const weightSlider = document.getElementById('weight-slider');
			const heightSlider = document.getElementById('height-slider');

			weightInput.addEventListener('input', (e) => {
				weightSlider.value = e.target.value;
				update();
			});
			weightSlider.addEventListener('input', (e) => {
				weightInput.value = e.target.value;
				update();
			});

			heightInput.addEventListener('input', (e) => {
				heightSlider.value = e.target.value;
				update();
			});
			heightSlider.addEventListener('input', (e) => {
				heightInput.value = e.target.value;
				update();
			});

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				update();
			});

			update();
		</script>
	</body>
</html>
