---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const title = `Calcul TVA | ${SITE_TITLE}`;
const description = 'Calculez facilement le prix hors taxe, le prix TTC et le montant de la TVA selon le taux appliqué.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-hero">
				<p class="eyebrow">Impôts & contributions</p>
				<h1>Calcul TVA</h1>
				<p>Transformez le prix HT en prix TTC ou l’inverse selon le taux de TVA.</p>
			</section>

			<section class="hero-card">
				<form id="tva-form">
					<label for="price">Prix</label>
					<input id="price" name="price" type="number" min="0" step="0.01" value="120" required />
					<label for="mode">Mode</label>
					<select id="mode" name="mode">
						<option value="ht">Prix HT → TTC</option>
						<option value="ttc">Prix TTC → HT</option>
					</select>
					<label for="rate">Taux de TVA</label>
					<select id="rate" name="rate">
						<option value="0.20">20%</option>
						<option value="0.055">5,5%</option>
						<option value="0.10">10%</option>
						<option value="0.021">2,1%</option>
					</select>
					<button type="submit">Calculer</button>
				</form>
				<div id="results" class="results" aria-live="polite"></div>
			</section>
		</main>
		<Footer />
		<script type="module">
			const form = document.getElementById('tva-form');
			const results = document.getElementById('results');

			function formatEUR(value) {
				return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 }).format(value);
			}

			function update() {
				const price = Number(document.getElementById('price').value || 0);
				const mode = document.getElementById('mode').value;
				const rate = Number(document.getElementById('rate').value || 0);

				let ht = 0;
				let ttc = 0;
				let amount = 0;

				if (mode === 'ht') {
					ht = price;
					amount = ht * rate;
					ttc = ht + amount;
				} else {
					ttc = price;
					ht = ttc / (1 + rate);
					amount = ttc - ht;
				}

				results.innerHTML = `
					<p><strong>Prix HT :</strong> ${formatEUR(ht)}</p>
					<p><strong>TVA (${(rate * 100).toFixed(1)}%) :</strong> ${formatEUR(amount)}</p>
					<p><strong>Prix TTC :</strong> ${formatEUR(ttc)}</p>
				`;
			}

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				update();
			});

			update();
		</script>
	</body>
</html>
