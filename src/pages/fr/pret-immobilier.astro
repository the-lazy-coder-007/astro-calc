---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_TITLE } from '../../consts';

const title = `Prêt immobilier | ${SITE_TITLE}`;
const description = 'Calculez les mensualités, le total des intérêts et le coût global de votre prêt immobilier.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<Breadcrumb items={[
				{ label: 'Accueil', href: '/' },
				{ label: 'Calculatrices', href: '/fr' },
				{ label: 'Logement & immobilier', href: '/fr/logement' },
				{ label: 'Prêt immobilier' }
			]} />
			<section class="page-hero">
				<p class="eyebrow">Logement & immobilier</p>
				<h1>Prêt immobilier</h1>
				<p>Calculez vos mensualités, les intérêts et le coût total d’un crédit immobilier.</p>
			</section>

			<section class="hero-card">
				<div class="calculator-input-group">
					<form id="loan-form">
						<label for="amount">Montant emprunté</label>
						<div class="input-with-unit">
							<input id="amount" name="amount" type="number" min="0" step="5000" value="250000" required />
							<span class="input-unit">€</span>
						</div>
						<input type="range" id="amount-slider" min="0" max="1000000" step="5000" value="250000" />
						<div class="input-hint">Montant total du prêt immobilier</div>
						
						<label for="rate" style="margin-top: 1.5rem;">Taux annuel</label>
						<div class="input-with-unit">
							<input id="rate" name="rate" type="number" min="0" step="0.01" value="3.10" required />
							<span class="input-unit">%</span>
						</div>
						<input type="range" id="rate-slider" min="0" max="8" step="0.01" value="3.10" />
						<div class="input-hint">Taux d'intérêt annuel</div>
						
						<label for="years" style="margin-top: 1.5rem;">Durée du prêt</label>
						<div class="input-with-unit">
							<input id="years" name="years" type="number" min="1" step="1" value="20" required />
							<span class="input-unit">ans</span>
						</div>
						<input type="range" id="years-slider" min="1" max="40" step="1" value="20" />
						<div class="input-hint">De 1 à 40 ans</div>
						
						<button type="submit" style="margin-top: 1rem;">Calculer mensualité</button>
					</form>
				</div>
				<div id="results" class="results calculator-result" aria-live="polite"></div>
			</section>
		</main>
		<Footer />
		<script type="module">
			const form = document.getElementById('loan-form');
			const results = document.getElementById('results');

			function formatEUR(value) {
				return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(value);
			}

			function update() {
				const amount = Number(document.getElementById('amount').value || 0);
				const annualRate = Number(document.getElementById('rate').value || 0) / 100;
				const years = Number(document.getElementById('years').value || 0);
				const months = years * 12;
				const monthlyRate = annualRate / 12;
				const monthlyPayment = monthlyRate > 0 ? (amount * monthlyRate) / (1 - Math.pow(1 + monthlyRate, -months)) : amount / months;
				const totalPaid = monthlyPayment * months;
				const totalInterest = totalPaid - amount;

				results.innerHTML = `
					<p><strong>Mensualité estimée :</strong> ${formatEUR(monthlyPayment)}</p>
					<p><strong>Coût total du crédit :</strong> ${formatEUR(totalPaid)}</p>
					<p><strong>Intérêts payés :</strong> ${formatEUR(totalInterest)}</p>
					<p><strong>Durée :</strong> ${years} ans (${months} mois)</p>
				`;
			}

			const amountInput = document.getElementById('amount');
			const rateInput = document.getElementById('rate');
			const yearsInput = document.getElementById('years');
			const amountSlider = document.getElementById('amount-slider');
			const rateSlider = document.getElementById('rate-slider');
			const yearsSlider = document.getElementById('years-slider');

			amountInput.addEventListener('input', (e) => { amountSlider.value = e.target.value; update(); });
			amountSlider.addEventListener('input', (e) => { amountInput.value = e.target.value; update(); });
			rateInput.addEventListener('input', (e) => { rateSlider.value = e.target.value; update(); });
			rateSlider.addEventListener('input', (e) => { rateInput.value = e.target.value; update(); });
			yearsInput.addEventListener('input', (e) => { yearsSlider.value = e.target.value; update(); });
			yearsSlider.addEventListener('input', (e) => { yearsInput.value = e.target.value; update(); });

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				update();
			});

			update();
		</script>
	</body>
</html>
